# YuMap Agents — 環境変数設定
# コピーして .env にリネームし、実際の値を設定してください

# Supabase（必須）
SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# 動作設定
OPERATION_MODE=aggressive    # aggressive | maintenance
BATCH_SIZE=50                # 1バッチあたりの施設数
REQUEST_DELAY=3000           # ブラウザリクエスト間隔(ms)

# 注意: ANTHROPIC_API_KEY は不要
# Claude Code の OAuth サブスクリプション認証を使用します
